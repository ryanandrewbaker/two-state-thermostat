{
  "name": "two-state-thermostat",
  "version": "0.3.4",
  "description": "A dual-range Home Assistant Lovelace climate card with staged Boost and Maintain feedback",
  "type": "module",
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "thermostat",
    "climate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanandrewbaker/two-state-thermostat.git"
  },
  "bugs": {
    "url": "https://github.com/ryanandrewbaker/two-state-thermostat/issues"
  },
  "homepage": "https://github.com/ryanandrewbaker/two-state-thermostat#readme",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
